{
  "name": "gitogether-app",
  "productName": "Gitogether",
  "version": "0.1.0",
  "description": "GitHub 이슈를 Jira로 동기화하는 에픽 보드",
  "author": "Gitogether",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win",
    "build:web": "vite build --config vite.web.config.ts",
    "web": "npm run build:web && node server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@dnd-kit/core": "^6.3.1",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.59.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.gitogether.app",
    "productName": "Gitogether",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "resources/**"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Gitogether-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Gitogether-${version}-portable.exe"
    }
  }
}
